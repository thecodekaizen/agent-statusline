{
  "name": "agent-statusline",
  "version": "0.1.0",
  "description": "Ultra-fast, zero-dependency Powerline statusline for AI coding agents (Antigravity, Codex, Claude Code) and terminal prompts",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agent-statusline": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecodekaizen/agent-statusline.git"
  },
  "bugs": {
    "url": "https://github.com/thecodekaizen/agent-statusline/issues"
  },
  "homepage": "https://github.com/thecodekaizen/agent-statusline#readme",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node ./dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "statusline",
    "powerline",
    "antigravity",
    "codex",
    "claude-code",
    "terminal",
    "prompt",
    "ai-agents",
    "npx"
  ],
  "author": "thecodekaizen",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
